# Public frontend configuration for Multiverse of Monsoon.
# WARNING: All VITE_* variables are bundled into client-side JavaScript and are public.
# Never store API keys, tokens, or secrets in frontend environment variables.

# Base URL used by the browser to reach the FastAPI climate model backend.
# Defaults to /api so local development and Vite preview use the same-origin proxy.
VITE_API_BASE_URL="/api"

# Backend target used by the Vite dev server and Vite preview server proxy.
# Not used directly by the browser in production deployments.
VITE_API_PROXY_TARGET="http://localhost:8000"

# Verified HTTP method for the /health endpoint per docs/API_CONTRACT.md.
VITE_HEALTH_METHOD="POST"

# Default request timeout in milliseconds for simulation and health requests.
VITE_API_TIMEOUT_MS="30000"

# Development/testing synthetic fixture toggle (disabled by default; excluded from production builds).
# Never enable in production deployments.
VITE_ENABLE_FIXTURE="false"
